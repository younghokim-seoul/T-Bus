<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#fed"

    tools:context="com.windnsoft.tbus.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        >


        <LinearLayout
            android:id="@+id/layout_head"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/DarkOrange"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageView9"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_margin="5dip"
                android:src="@drawable/ic_launcher_mdpi"
                />

            <TextView
                android:id="@+id/ilTitleTxt"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="9"
                android:gravity="center_vertical"
                android:text="업체 정보"
                android:textAppearance="?android:attr/textAppearanceMedium"

                android:textColor="@color/White"/>

            <ImageView
                android:id="@+id/topCloseBtn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginRight="5dp"
                android:layout_weight="1"
                android:padding="1dp"
                android:src="@drawable/xbutton_black"
                />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_body"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            >

            <ImageView
                android:id="@+id/advImg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/Black"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Spinner
                    android:id="@+id/coLocale1Sp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/prg_border_orange"
                    android:padding="6dp"/>

                <Spinner
                    android:id="@+id/coLocale2Sp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/prg_border_orange"
                    android:padding="6dp"/>
            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clickable="false"
                android:gravity="right">

                <com.windnsoft.tbus.Fragment.CompanyListView
                    android:id="@+id/coUserListView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                </com.windnsoft.tbus.Fragment.CompanyListView>


            </RelativeLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_bottom"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="@color/Black"
            android:orientation="horizontal"
            android:padding="4dp"
            >

            <ImageView
                android:id="@+id/bottomNewsBtn"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/news_off"
                />

            <ImageView
                android:id="@+id/bottomCompanyBtn"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/company_on"
                />

            <ImageView
                android:id="@+id/bottomInfoBtn"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/info_off"
                />

            <ImageView
                android:id="@+id/bottomTalkieBtn"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/walkietalkie_off"
                />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
