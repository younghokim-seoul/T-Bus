<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:tools="http://schemas.android.com/tools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/transparent"
                tools:context="com.windnsoft.tbus.MainActivity">

    <LinearLayout
        android:id="@+id/clTop"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentTop="true"
        android:background="@drawable/popup_title"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="215dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingLeft="85dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="친구 초대"
                android:textAppearance="?android:attr/textAppearanceLarge"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="85dp"
            android:layout_height="match_parent"
            android:gravity="left|center_vertical">

            <Button
                android:id="@+id/clCloseBt"
                android:layout_width="68dp"
                android:layout_height="36dp"
                android:background="@drawable/xml_btn_close"
                android:text="@string/btn_close"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textColor="@color/White"/>
        </LinearLayout>
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/itemlist_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/clTop"
        android:background="@color/White"
        android:gravity="center"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/itemlist_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableLeft="@android:drawable/ic_menu_search"
            android:singleLine="true"
            android:textColor="@color/Black">

        </EditText>

    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView xmlns:android="http://schemas.android.com/apk/res/android"
                                            xmlns:app="http://schemas.android.com/apk/res-auto"
                                            xmlns:tools="http://schemas.android.com/tools"
                                            android:id="@+id/itemlist_list"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_above="@+id/clBottom"
                                            android:layout_below="@+id/itemlist_top"
                                            android:background="@color/White"
                                            app:layoutManager="LinearLayoutManager"
                                            tools:listitem="@layout/callsms_list_item"/>

    <LinearLayout
        android:id="@+id/clBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/popup_tail"
        android:orientation="vertical">

    </LinearLayout>

</RelativeLayout>
